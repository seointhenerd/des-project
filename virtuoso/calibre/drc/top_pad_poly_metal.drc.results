3DMIM.R.10  { @ CTM and CBM termianls must be connected through Mtop
    BPM5_CHECK = M5xd INTERACT (BPM5_3D INTERACT CMM5)
    VIA5_CHECK = VIA5i NOT CMMVIA
    BPM5_CHECK INTERACT VIA5_CHECK BY NET > 1
}
