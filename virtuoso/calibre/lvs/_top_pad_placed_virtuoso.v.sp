Xclk_pad pad_in $PINS DataIn=clk_PAD pad=clk VSS=VSS VDD=VDD 
Xcs_n_pad pad_in $PINS DataIn=cs_n_PAD pad=cs_n VSS=VSS VDD=VDD 
