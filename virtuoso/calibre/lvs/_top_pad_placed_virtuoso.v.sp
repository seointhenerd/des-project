.SUBCKT top_pad clk rst sclk cs_n mosi miso 
Xcore TopModule $PINS clk=clk_PAD rst=rst_PAD sclk=sclk_PAD cs_n=cs_n_PAD 
+ mosi=mosi_PAD miso=miso_PAD VDD=VDD VSS=VSS 
